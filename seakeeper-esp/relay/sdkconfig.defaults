# Project defaults for the SeaKeeper relay (WT32-ETH01, ESP32, 4 MB flash).
# Applied by `idf.py set-target esp32` / `idf.py build`.

CONFIG_IDF_TARGET="esp32"

# WT32-ETH01 has 4 MB flash and no PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Two listeners plus several simultaneous connections (web page opens a handful
# of sockets, plus the MQTT WebSocket).
CONFIG_LWIP_MAX_SOCKETS=16

# Networking hardware.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_USE_SPI_ETHERNET=n

# Small binary, and enough logging to diagnose without a second flash cycle.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
