# Project defaults for the SeaKeeper relay (WT32-ETH01, ESP32, 4 MB flash).
# Applied by `idf.py set-target esp32` / `idf.py build`.

CONFIG_IDF_TARGET="esp32"

# WT32-ETH01 has 4 MB flash and no PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Each relayed connection uses two sockets (client + upstream), and the web
# listener allows 6 at once because that is the browser per-host cap. 8
# connections = 16 sockets, plus 2 listeners = 18, so keep both pools at 20.
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_MAX_ACTIVE_TCP=20

# Networking hardware.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_USE_SPI_ETHERNET=n

# Small binary, and enough logging to diagnose without a second flash cycle.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y

# 3 MB app partition instead of the 1 MB default (see partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
