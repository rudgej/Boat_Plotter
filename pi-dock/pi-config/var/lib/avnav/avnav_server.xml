<?xml version="1.0" ?>
<!-- AvNav server configuration for the N100 plotter (bossy).

     Data flow: NMEA2000 on can0 -> Signal K (:3000) -> AvNav through
     AVNSignalKHandler below. AvNav does NOT read the CAN bus itself,
     so there is deliberately no builtin-canboat plugin enabled.

     Charts: MBTiles / GEMF files in /var/lib/avnav/charts.
     o-charts (oeSENC) charts live in /var/lib/avnav/ochartsng/charts and
     are served by the ochartsng plugin, which registers itself - it needs
     no entry here.

     AvNav rewrites this file when settings are changed in its GUI, so treat
     GUI changes as the source of truth once the boat is in service. -->
<AVNServer>

	<!-- USB serial NMEA sources, auto-detected (AIS receiver, handheld,
	     old plotter output). Autobaud between 4800 and 38400. -->
	<AVNUsbSerialReader maxDevices="5" allowUnknown="true" baud="38400" minbaud="4800">
	</AVNUsbSerialReader>

	<!-- Onboard RS485 ports, exposed by /etc/udev/rules.d/60-rs485.rules.
	     Both are listen-only inputs. Uncomment and set the baud rate for the
	     device that is actually wired in; leaving them commented avoids
	     opening ports that have nothing attached. -->
	<!-- <AVNSerialReader name="rs485-1" port="/dev/rs485-1" baud="4800" minbaud="4800"/> -->
	<!-- <AVNSerialReader name="rs485-2" port="/dev/rs485-2" baud="38400" minbaud="4800"/> -->

	<!-- Bluetooth NMEA (SPP). Disabled: the wireless link on this boat is an
	     A2DP speaker handled by BlueALSA, not an NMEA source. -->
	<!-- <AVNBlueToothReader maxDevices="5"></AVNBlueToothReader> -->

	<!-- NMEA in/out for external tools such as OpenCPN -->
	<AVNUdpReader port="34667" minTime="100"/>
	<!--<AVNSocketReader host="localhost" port="34568"/>-->
	<AVNSocketWriter port="34567" maxDevices="5" filter="" read="true" minTime="100" avahiName="avnav-server"/>
	<AVNTrackWriter interval="10" distance="100"/>

	<AVNHttpServer httpPort="8080"/>
	<AVNCommandHandler>
		<Command name="sound" command="mpg123 -q" repeat="1"/>
	</AVNCommandHandler>

	<AVNPluginHandler>
		<!-- ##CANBOAT
		<builtin-canboat enabled="true" allowKeyOverwrite="true" autoSendRMC="30" sourceName="canboatgen"/>
		##CANBOAT -->
	</AVNPluginHandler>

	<AVNSignalKHandler uuid="3ef4b97d-9963-4e72-bf4b-e887fcb19877" migrated="True" decodeData="true"/>
</AVNServer>
