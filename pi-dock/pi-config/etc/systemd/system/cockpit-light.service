[Unit]
Description=Cockpit lighting automation (dusk to 23:00)
After=signalk.service
Wants=signalk.service

[Service]
Type=simple
User=pi
EnvironmentFile=/etc/signalk-automation.env
ExecStart=/usr/bin/python3 /usr/local/bin/cockpit-light.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
