[connection]
id=3cpr
uuid=53d8f262-7660-48f3-89b1-47693640f984
type=wifi
# Priority 5: home network. Used when Bossywifi is not in range.
autoconnect-priority=5
interface-name=wlp3s0

[wifi]
mode=infrastructure
ssid=3cpr
# Never randomise the MAC. With a per-scan random MAC the UniFi AP accepted the
# association, then deauthenticated 2s later with reason 6
# (CLASS2_FRAME_FROM_NONAUTH_STA). NetworkManager read that as a bad key, asked
# for a new one, found no agent, and gave up - so the box booted with no network
# at all. Pinning the MAC fixes it.
cloned-mac-address=permanent

[wifi-security]
key-mgmt=wpa-psk
psk=CHANGE_ME

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=ignore

[proxy]
