# Offline boat manuals. Served on :8081 so it doesn't clash with Signal K (3000)
# or AvNav (8080). nginx rather than `python -m http.server` because only nginx
# honours HTTP Range requests, which is what lets large PDFs page/scroll in the
# kiosk browser instead of downloading in one lump.
server {
    listen 8081 default_server;
    listen [::]:8081 default_server;
    server_name _;

    root /home/pi/manuals;
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;
    charset utf-8;

    # Manuals are large PDFs; don't hold them in memory.
    sendfile on;
    tcp_nopush on;

    # The kiosk runs Chromium in app mode (--app), so there is NO toolbar and no
    # Back button. Tapping a PDF on a touchscreen would otherwise be a one-way
    # trip into Chromium's PDF viewer. A PDF request therefore gets a tiny
    # wrapper page with a large Back bar and the PDF in an iframe; the file
    # itself is served from /raw/ so Range requests still work.
    location ~* \.pdf$ {
        # This URI ends in .pdf, so nginx takes the type from the global
        # extension map and `default_type` is ignored. Override it here or the
        # wrapper is labelled application/pdf and the browser tries to parse
        # HTML as a PDF.
        types { text/html pdf; }
        default_type text/html;
        return 200 '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Manual</title><style>html,body{margin:0;height:100%;background:#2b2b2b;font-family:system-ui,sans-serif}#bar{height:72px;display:flex;align-items:center;gap:18px;padding:0 20px;background:#10223a;color:#fff;box-sizing:border-box}#bar a{color:#fff;text-decoration:none;font-size:24px;font-weight:700;padding:10px 20px;border:2px solid #fff;border-radius:12px;white-space:nowrap}#bar a:active{background:#fff;color:#10223a}#bar span{color:#c9d6e6;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}iframe{width:100%;height:calc(100% - 72px);border:0;display:block}</style></head><body><div id="bar"><a href="/" onclick="if(history.length>1){history.back();return false}">&#9664; Back</a><span>$request_uri</span></div><iframe src="/raw$request_uri"></iframe></body></html>';
    }

    # ^~ stops the regex above from matching these, so there is no recursion.
    location ^~ /raw/ {
        alias /home/pi/manuals/;
    }

    # Touch-friendly restyle of the generated index (bigger type, roomier rows).
    # Scoped to `location /` on purpose: add_after_body at server level would
    # also append this to /raw/ PDFs and corrupt them.
    location / {
        add_after_body /_manuals-index.css;
        try_files $uri $uri/ =404;
    }

    location = /_manuals-index.css {
        alias /etc/nginx/manuals-index.css;
        default_type text/html;
        add_header Cache-Control "no-cache";
    }

    access_log /var/log/nginx/manuals-access.log;
    error_log  /var/log/nginx/manuals-error.log warn;
}
